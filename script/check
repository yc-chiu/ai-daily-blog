#!/usr/bin/env bash
# 建置網站並確認 baseurl、首頁、文章頁與 RSS。
set -euo pipefail

cd "$(dirname "$0")/.."

export JEKYLL_ENV=production
bundle exec jekyll build --trace

test -f _site/index.html
test -f _site/feed.xml
test -f _site/about/index.html
test -f _site/tags/index.html
test -f _site/assets/css/style.css
test -f _site/404.html

post_html="$(find _site -type f -path '*anthropic-claude-unintended-actions*' -name 'index.html' | head -n 1)"
test -n "$post_html"
test ! -e _site/2026/10/12/sample-post/index.html

grep -q "AI 每日快報" _site/index.html
grep -q "Claude 測試時" _site/index.html
grep -q "Anthropic 於 10 月 9 日公開報告" _site/index.html
if grep -q "範例文章" _site/index.html; then
  echo "sample post is still on the home page" >&2
  exit 1
fi
grep -q 'href="/ai-daily-blog/assets/css/style.css"' _site/index.html
grep -q 'lang="zh-Hant-TW"' _site/index.html
grep -q "box-sizing" _site/assets/css/style.css
grep -q "Huninn" _site/assets/css/style.css
test -f _site/assets/fonts/jf-openhuninn-2.1.woff2
grep -q "<language>zh-TW</language>" _site/feed.xml
grep -q "Claude 測試時" _site/feed.xml
grep -q "參考來源" "$post_html"
grep -q "anthropic.com/research/investigating-unintended-model-actions" "$post_html"
grep -q "forklog.com/en/anthropic-disables-internet-access-for-claude-in-internal-evaluations" "$post_html"
grep -q 'href="/ai-daily-blog/2026/10/12/anthropic-claude-unintended-actions/"' _site/index.html
grep -q 'rel="canonical" href="https://yc-chiu.github.io/ai-daily-blog/"' _site/index.html
grep -q 'rel="canonical" href="https://yc-chiu.github.io/ai-daily-blog/2026/10/12/anthropic-claude-unintended-actions/"' "$post_html"
grep -q 'https://yc-chiu.github.io/ai-daily-blog/2026/10/12/anthropic-claude-unintended-actions/' _site/feed.xml
grep -q 'href="/ai-daily-blog/2026/10/12/anthropic-claude-unintended-actions/"' _site/tags/index.html
grep -q "最新" _site/index.html
if grep -R -n --include='*.html' --include='*.xml' -E 'href="/2026/' _site; then
  echo "post links are missing baseurl" >&2
  exit 1
fi
grep -q 'rel="alternate"' _site/index.html
grep -q "關於" _site/about/index.html
grep -q "Anthropic" _site/tags/index.html

amie_html="$(find _site -type f -path '*google-amie/index.html' | head -n 1)"
test -n "$amie_html"
test -f _site/assets/images/posts/2026-10-13-google-amie/cover.jpg
test -f _site/assets/images/posts/2026-10-13-google-amie/amie-timeline-2024-2026.png
test -f _site/assets/images/posts/2026-10-13-google-amie/lancet-trial-key-numbers.png
grep -q 'class="post-cover" src="/ai-daily-blog/assets/images/posts/2026-10-13-google-amie/cover.jpg"' "$amie_html"
grep -q 'src="/ai-daily-blog/assets/images/posts/2026-10-13-google-amie/lancet-trial-key-numbers.png"' "$amie_html"
grep -q 'src="/ai-daily-blog/assets/images/posts/2026-10-13-google-amie/amie-timeline-2024-2026.png"' "$amie_html"
grep -q 'src="/ai-daily-blog/assets/images/posts/2026-10-13-google-amie/cover.jpg"' _site/index.html
grep -q 'href="/ai-daily-blog/2026/10/13/google-amie/"' _site/index.html
grep -q "參考來源" "$amie_html"
grep -q "doi.org/10.1016/S0140-6736(26)01535-7" "$amie_html"
grep -q "elementsofai.com" "$amie_html"
if grep -q 'relative_url' "$amie_html"; then
  echo "inline image liquid was not rendered" >&2
  exit 1
fi
cover_line="$(grep -n 'class="post-cover"' "$amie_html" | head -n 1 | cut -d: -f1)"
sources_line="$(grep -n 'id="sources-title"' "$amie_html" | head -n 1 | cut -d: -f1)"
test -n "$cover_line"
test -n "$sources_line"
test "$sources_line" -gt "$cover_line"

python3 - << 'PY'
import xml.etree.ElementTree as ET
ET.parse("_site/feed.xml")
print("feed.xml is well-formed XML")
PY

if grep -R -n --include='*.html' --include='*.xml' -F '/ai-daily-blog/ai-daily-blog' _site; then
  echo "baseurl was doubled" >&2
  exit 1
fi

echo "OK: site built at _site/"
